@echo off
rem Copy this file to secrets.bat at the repository root. Never commit it.
rem Keep this file pure ASCII: cmd reads .bat as GBK and Chinese comments
rem can be split into broken half-commands.
rem MI_USER / MI_PASS are needed only for the first miservice login; after
rem ~/.mi.token exists, clear both.
rem MI_DID is the miotDID shown by "miservice mina" for the speaker.
set "MI_USER="
set "MI_PASS="
set "MI_DID="
set "REPUBLIC_OPENAI_API_KEY="
set "OPENAI_API_KEY="
